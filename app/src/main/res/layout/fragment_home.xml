<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <GridLayout
            android:id="@+id/letterGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="@integer/alphabet_column_count"
            android:layoutDirection="ltr"
            android:orientation="horizontal"
            android:padding="12dp"
            tools:itemCount="26"
            tools:listitem="@layout/item_alphabet_letter" />

    </androidx.core.widget.NestedScrollView
>

    <!-- 不要给 include 指定 layout_width/height，否则被 include 根节点上的 layout_behavior 会失效 -->
    <include
        android:id="@+id/wordDetail"
        layout="@layout/layout_word_detail" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
