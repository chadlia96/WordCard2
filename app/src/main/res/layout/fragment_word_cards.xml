<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="64dp"
    tools:context=".WordCardsFragment">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/wordBook"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginEnd="8dp"
        android:gravity="start|center_vertical"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:textAllCaps="false"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp"
        app:cornerRadius="14dp"
        app:icon="@drawable/arrow_drop_down_48"
        app:iconGravity="end"
        app:iconSize="36dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/playbackSpeed"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="俄语 · 日常基础词汇" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/playbackSpeed"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/playback_speed"
        app:layout_constraintBottom_toBottomOf="@id/wordBook"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/wordBook"
        app:srcCompat="@drawable/outline_bolt_boost_24"
        app:tint="?attr/colorPrimary" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/wordCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/wordBook"
        app:layout_constraintBottom_toBottomOf="parent"
        app:strokeWidth="0dp"
        tools:visibility="visible">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/word"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:singleLine="false"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="48sp"
                    app:backgroundTint="?attr/colorPrimaryContainer"
                    app:cornerRadius="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="20dp"
                    android:layout_marginHorizontal="20dp"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintWidth_max="wrap"
                    tools:text="мя́гкий2312312312312312312" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/partOfSpeech"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:layout_marginStart="8dp"
                    app:layout_constraintStart_toEndOf="@id/word"
                    app:layout_constraintBaseline_toBaselineOf="@id/word"
                    tools:text="a" />



                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/englishTranslation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="26sp"
                    app:layout_constraintTop_toBottomOf="@id/word"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:text="soft" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/chineseTranslation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="24sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/englishTranslation"
                    tools:text="柔软的；温和的" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sentences"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginHorizontal="20dp"
                    android:gravity="start|center_vertical"
                    android:minHeight="64dp"
                    android:paddingVertical="8dp"
                    android:singleLine="false"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    app:backgroundTint="?attr/colorPrimaryContainer"
                    app:cornerRadius="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/chineseTranslation"
                    tools:text="Этот хлеб очень мягкий.1231231231231231231323123" />



                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/sentenceTranslations"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:layout_marginHorizontal="20dp"
                    android:paddingVertical="8dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/sentences"

                    tools:text="这个面包很软。" />


            <ScrollView
                android:id="@+id/supplementalTextScroll"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/word_card_supplemental_background"
                android:saveEnabled="false"
                android:visibility="gone"
                tools:visibility="visible"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/sentenceTranslations"
                app:layout_constraintBottom_toTopOf="@id/cardDivider">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/supplementalText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:textSize="16sp" />
            </ScrollView>

            <View
                android:id="@+id/cardDivider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="?attr/colorOutlineVariant"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/cardActions" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardActions"
                android:layout_width="0dp"
                android:layout_height="64dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/previousWord"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/button_wordcard_background"
                    android:backgroundTint="?attr/colorSurfaceContainerLow"
                    android:contentDescription="@string/word_card_previous"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/learnAgain"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:srcCompat="@drawable/top_left_48"
                    app:tint="@color/design_default_color_primary_dark" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/learnAgain"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/button_wordcard_background"
                    android:backgroundTint="?attr/colorPrimaryContainer"
                    android:contentDescription="@string/word_card_again"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    app:layout_constraintStart_toEndOf="@id/previousWord"
                    app:layout_constraintEnd_toStartOf="@id/markLearned"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:srcCompat="@drawable/cycle_24"
                    app:tint="@color/design_default_color_on_secondary" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/markLearned"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/button_wordcard_background"
                    android:backgroundTint="?attr/colorPrimary"
                    android:contentDescription="@string/word_card_learned"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    app:layout_constraintStart_toEndOf="@id/learnAgain"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:srcCompat="@drawable/check_circle_unread_24"
                    app:tint="@color/design_default_color_on_primary" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
